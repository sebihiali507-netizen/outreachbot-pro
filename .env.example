# ── SERVER ──
PORT=24771
NODE_ENV=production
DATA_DIR=/app/data
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# ── SENDER IDENTITY ──
SENDER_NAME=ITECH PRO

# ── SMTP ACCOUNTS ──
SMTP_ACCOUNTS=[{"user":"your-email@gmail.com","pass":"your-app-password"}]

# ── EMAIL LIMITS ──
DAILY_EMAIL_CAP=200
EMAIL_DELAY_MIN_MS=120000
EMAIL_DELAY_MAX_MS=300000

# ── AUTO-SEND CRON ──
CRON_SCHEDULE=*/2 * * * *

# ── GEMINI AI ──
GEMINI_API_KEY=your-gemini-key

# ── IMAP (Reply Detection) ──
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASS=your-app-password
